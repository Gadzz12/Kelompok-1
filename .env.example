# ========================================================
# Konfigurasi Aplikasi To-Do List
# ========================================================

# Port server HTTP (default: 8080)
PORT=8080

# Connection String PostgreSQL (Neon / Supabase / Local PostgreSQL) - Wajib diisi
#
# Contoh format PostgreSQL (Neon / Supabase / Cloud):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
# atau
# DATABASE_URL="postgresql://postgres:PASSWORD@db.xxxxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres?sslmode=require"
#
# Catatan: Gunakan sslmode=require atau verify-full untuk keamanan koneksi TLS.
DATABASE_URL=
